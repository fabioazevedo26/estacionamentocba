<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 mb-0"><i class="bi bi-truck-front me-2"></i>Veículos</h1>
  <a class="btn btn-primary" href="/veiculos/novo"><i class="bi bi-plus-lg me-1"></i>Novo veículo</a>
</div>

<form class="card card-body shadow-sm mb-3" method="get">
  <div class="row g-2 align-items-end">
    <div class="col-md-5">
      <label class="form-label small" for="q">Busca</label>
      <input class="form-control" id="q" name="q" value="<%= f.q %>" placeholder="Placa, modelo ou proprietário">
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small" for="tipo">Tipo</label>
      <select class="form-select" id="tipo" name="tipo">
        <option value="">Todos</option>
        <% for (const t of tipos) { %><option value="<%= t %>"<%= f.tipo === t ? ' selected' : '' %>><%= rotulo(t) %></option><% } %>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small" for="status">Status</label>
      <select class="form-select" id="status" name="status">
        <option value="">Todos</option>
        <% for (const s of ['ATIVO', 'BLOQUEADO', 'INATIVO']) { %>
          <option value="<%= s %>"<%= f.status === s ? ' selected' : '' %>><%= rotulo(s) %></option>
        <% } %>
      </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <button class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Filtrar</button>
      <a class="btn btn-outline-secondary" href="/veiculos">Limpar</a>
    </div>
  </div>
</form>

<div class="table-responsive card shadow-sm mb-3">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr><th>Placa</th><th>Tipo</th><th>Marca/Modelo</th><th>Cor</th><th>Proprietário</th><th>Situação</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% if (!lista.length) { %><tr><td colspan="7" class="text-center text-body-secondary py-4">Nenhum veículo encontrado.</td></tr><% } %>
      <% for (const v of lista) { %>
        <tr>
          <td><a href="/veiculos/<%= v.id %>" class="placa <%= placaClasse(v.placa) %> text-decoration-none"><%= placa(v.placa) %></a></td>
          <td><%= rotulo(v.tipo) %></td>
          <td><%= v.marca_modelo || '' %></td>
          <td><%= v.cor || '' %></td>
          <td><% if (v.proprietario_id) { %><a href="/pessoas/<%= v.proprietario_id %>" class="text-decoration-none"><%= v.proprietario_nome %></a><% } else { %><span class="text-body-secondary">—</span><% } %></td>
          <td><%- v.dentro ? '<span class="chip chip-info"><i class="bi bi-p-circle-fill" aria-hidden="true"></i>No estacionamento</span>' : '<span class="text-body-secondary small">fora</span>' %></td>
          <td><%- statusChip(v.status) %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/paginacao') %>
<%- include('../partials/footer') %>
