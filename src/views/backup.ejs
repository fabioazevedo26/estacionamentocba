<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 mb-0"><i class="bi bi-database me-2"></i>Backups</h1>
  <form method="post" action="/backup/agora">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-primary"><i class="bi bi-download me-1"></i>Baixar backup agora</button>
  </form>
</div>
<div class="alert alert-info">
  <i class="bi bi-info-circle me-1"></i>Um backup automático é feito todos os dias às 23:30.
  São mantidos os últimos <strong><%= retencao %></strong> dias. Para restaurar, siga as instruções do README.
</div>
<div class="table-responsive card shadow-sm">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Arquivo</th><th>Data</th><th class="text-end">Tamanho</th><th></th></tr></thead>
    <tbody>
      <% if (!backups.length) { %><tr><td colspan="4" class="text-center text-body-secondary py-4">Nenhum backup ainda.</td></tr><% } %>
      <% for (const b of backups) { %>
        <tr>
          <td><code><%= b.nome %></code></td>
          <td><%= fmtDataHora(b.data) %></td>
          <td class="text-end"><%= (b.tamanho / 1024).toLocaleString('pt-BR', { maximumFractionDigits: 0 }) %> KB</td>
          <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/backup/arquivo/<%= encodeURIComponent(b.nome) %>"><i class="bi bi-download"></i> Baixar</a></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
