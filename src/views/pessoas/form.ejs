<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-lg-9 col-xl-7">
    <h1 class="h3 mb-3"><i class="bi bi-person-vcard me-2"></i><%= titulo %></h1>
    <% if (erro) { %><div class="alert alert-danger"><i class="bi bi-exclamation-octagon me-1"></i><%= erro %></div><% } %>
    <form method="post" action="<%= pessoa.id ? '/pessoas/' + pessoa.id : '/pessoas' %>" class="card card-body shadow-sm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label" for="nome">Nome completo *</label>
          <input class="form-control" id="nome" name="nome" required maxlength="120" value="<%= pessoa.nome || '' %>" autofocus>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="tipo">Tipo *</label>
          <select class="form-select" id="tipo" name="tipo" required>
            <option value="COLABORADOR"<%= pessoa.tipo === 'COLABORADOR' ? ' selected' : '' %>>Colaborador</option>
            <option value="VISITANTE"<%= pessoa.tipo === 'VISITANTE' ? ' selected' : '' %>>Visitante</option>
          </select>
        </div>
        <div class="col-md-6">
          <%- include('../partials/select-opcao', { nome: 'cargo', rotulo: 'Cargo', lista: cargos,
                valor: pessoa.cargo === '__outro__' ? pessoa.cargo_outro : pessoa.cargo }) %>
        </div>
        <div class="col-md-6">
          <%- include('../partials/select-opcao', { nome: 'setor', rotulo: 'Setor', lista: setores,
                valor: pessoa.setor === '__outro__' ? pessoa.setor_outro : pessoa.setor }) %>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="empresa">Empresa</label>
          <input class="form-control" id="empresa" name="empresa" maxlength="120" value="<%= pessoa.empresa || '' %>">
          <div class="form-text">Usado principalmente para visitantes e terceirizados.</div>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="telefone">Telefone (opcional)</label>
          <input class="form-control" id="telefone" name="telefone" maxlength="30" value="<%= pessoa.telefone || '' %>">
        </div>
        <div class="col-12">
          <label class="form-label" for="observacao">Observação</label>
          <textarea class="form-control" id="observacao" name="observacao" rows="2" maxlength="500"><%= pessoa.observacao || '' %></textarea>
        </div>
      </div>
      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar</button>
        <a class="btn btn-outline-secondary" href="<%= pessoa.id ? '/pessoas/' + pessoa.id : '/pessoas' %>">Cancelar</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
