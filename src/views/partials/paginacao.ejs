<% if (pag.paginas > 1) { %>
<nav aria-label="Paginação" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
  <small class="text-body-secondary"><%= pag.total %> registro(s) · página <%= pag.pagina %> de <%= pag.paginas %></small>
  <ul class="pagination mb-0">
    <li class="page-item<%= pag.pagina <= 1 ? ' disabled' : '' %>"><a class="page-link" href="<%= pag.url(1) %>">«</a></li>
    <li class="page-item<%= pag.pagina <= 1 ? ' disabled' : '' %>"><a class="page-link" href="<%= pag.url(pag.pagina - 1) %>">‹</a></li>
    <% for (let n = Math.max(1, pag.pagina - 2); n <= Math.min(pag.paginas, pag.pagina + 2); n++) { %>
      <li class="page-item<%= n === pag.pagina ? ' active' : '' %>"><a class="page-link" href="<%= pag.url(n) %>"><%= n %></a></li>
    <% } %>
    <li class="page-item<%= pag.pagina >= pag.paginas ? ' disabled' : '' %>"><a class="page-link" href="<%= pag.url(pag.pagina + 1) %>">›</a></li>
    <li class="page-item<%= pag.pagina >= pag.paginas ? ' disabled' : '' %>"><a class="page-link" href="<%= pag.url(pag.paginas) %>">»</a></li>
  </ul>
</nav>
<% } else { %>
<small class="text-body-secondary"><%= pag.total %> registro(s)</small>
<% } %>
