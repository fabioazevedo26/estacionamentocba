<!doctype html>
<html lang="pt-BR" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo ? titulo + ' · ' : '' %>EstacionamentoCBA</title>
  <link rel="icon" href="/img/favicon.png" type="image/png">
  <script src="/js/tema.js"></script>
  <link rel="stylesheet" href="/vendor/fonts/fontes.css">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body data-tz="<%= tz %>" data-servidor-ms="<%= Date.now() %>"<% if (typeof autoRefresh !== 'undefined' && autoRefresh) { %> data-auto-refresh="<%= autoRefresh %>"<% } %>>
<% if (usuario) { %>
<a class="visually-hidden-focusable btn btn-light m-2 position-absolute" href="#conteudo">Pular para o conteúdo</a>
<nav class="navbar navbar-expand-xl navbar-dark navbar-cba" aria-label="Menu principal">
  <div class="container-fluid">
    <a class="navbar-brand" href="/" title="EstacionamentoCBA — Portaria">
      <img src="/img/logo-cba-branco.png" alt="CBA — Centro de Bionegócios da Amazônia" width="43" height="48">
      <span class="divisor" aria-hidden="true"></span>
      <span>EstacionamentoCBA</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
            aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menu">
      <%
        const itens = [
          ['/', 'Portaria', 'bi-door-open'],
          ['/patio', 'Pátio agora', 'bi-car-front'],
          ['/pessoas', 'Pessoas', 'bi-people'],
          ['/veiculos', 'Veículos', 'bi-truck-front'],
          ['/movimentacoes', 'Movimentações', 'bi-arrow-left-right'],
          ['/relatorios', 'Relatórios', 'bi-file-earmark-spreadsheet'],
          ['/auditoria', 'Auditoria', 'bi-shield-check'],
        ];
      %>
      <ul class="navbar-nav me-auto">
        <% for (const [href, nome, icone] of itens) {
             const ativo = href === '/' ? caminho === '/' : caminho.startsWith(href); %>
          <li class="nav-item">
            <a class="nav-link<%= ativo ? ' active' : '' %>" href="<%= href %>"<%- ativo ? ' aria-current="page"' : '' %>>
              <i class="bi <%= icone %>" aria-hidden="true"></i><%= nome %>
              <% if (href === '/patio') { %>
                <span class="badge contador-patio" title="Veículos no pátio agora"><%= patioCount %><span class="visually-hidden"> veículos no pátio</span></span>
              <% } %>
            </a>
          </li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle me-1"></i><%= usuario.usuario %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button class="dropdown-item" type="button" data-alternar-tema><i class="bi bi-circle-half me-2"></i><span class="rotulo-tema">Modo noturno</span></button></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/conta/senha"><i class="bi bi-key me-2"></i>Trocar senha</a></li>
            <li><a class="dropdown-item" href="/backup"><i class="bi bi-database me-2"></i>Backups</a></li>
            <li>
              <form method="post" action="/backup/agora">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="dropdown-item" type="submit"><i class="bi bi-download me-2"></i>Baixar backup agora</button>
              </form>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form method="post" action="/logout">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sair</button>
              </form>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>
<main id="conteudo" class="container-fluid py-4 px-3 px-lg-4">
<%- include('flash') %>
