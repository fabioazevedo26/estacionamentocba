<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 mb-0"><i class="bi bi-file-earmark-spreadsheet me-2"></i>Relatórios</h1>
  <a class="btn btn-success" href="<%= exportarUrl %>"><i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel</a>
</div>

<form class="card card-body shadow-sm mb-3" method="get" id="form-relatorio">
  <div class="row g-3 align-items-end">
    <div class="col-sm-6 col-lg-3">
      <label class="form-label small" for="periodo">Período</label>
      <select class="form-select" id="periodo" name="periodo">
        <% for (const [v, nome] of Object.entries(periodos)) { %>
          <option value="<%= v %>"<%= f.periodo === v ? ' selected' : '' %>><%= nome %></option>
        <% } %>
      </select>
    </div>
    <div class="col-sm-6 col-lg-3">
      <label class="form-label small" for="acesso">Tipo de acesso</label>
      <select class="form-select" id="acesso" name="acesso">
        <% for (const [v, nome] of Object.entries(acessos)) { %>
          <option value="<%= v %>"<%= f.acesso === v ? ' selected' : '' %>><%= nome %></option>
        <% } %>
      </select>
    </div>
    <div class="col-sm-6 col-lg-3 campo-periodo" data-periodo="mes_especifico">
      <label class="form-label small" for="mes">Mês</label>
      <input class="form-control" type="month" id="mes" name="mes" value="<%= f.mes || r.de.slice(0, 7) %>">
    </div>
    <div class="col-6 col-lg-2 campo-periodo" data-periodo="intervalo">
      <label class="form-label small" for="de">De</label>
      <input class="form-control" type="date" id="de" name="de" value="<%= f.de || r.de %>">
    </div>
    <div class="col-6 col-lg-2 campo-periodo" data-periodo="intervalo">
      <label class="form-label small" for="ate">Até</label>
      <input class="form-control" type="date" id="ate" name="ate" value="<%= f.ate || r.ate %>">
    </div>
    <div class="w-100 d-none d-lg-block m-0"></div>
    <div class="col-sm-6 col-lg-3">
      <%- include('../partials/pessoa-picker', { campo: 'motorista_id', valorId: f.motorista_id, valorNome: motoristaNome,
            rotulo: 'Pessoa (motorista ou pedestre)', placeholder: 'Todas' }) %>
    </div>
    <div class="col-sm-6 col-lg-2">
      <label class="form-label small" for="placa">Placa</label>
      <input class="form-control text-uppercase" id="placa" name="placa" value="<%= f.placa %>" maxlength="10">
    </div>
    <div class="col-sm-6 col-lg-2">
      <label class="form-label small" for="tipo_pessoa">Tipo de pessoa</label>
      <select class="form-select" id="tipo_pessoa" name="tipo_pessoa">
        <option value="">Todos</option>
        <option value="COLABORADOR"<%= f.tipo_pessoa === 'COLABORADOR' ? ' selected' : '' %>>Colaborador</option>
        <option value="VISITANTE"<%= f.tipo_pessoa === 'VISITANTE' ? ' selected' : '' %>>Visitante</option>
      </select>
    </div>
    <div class="col-sm-6 col-lg-2">
      <label class="form-label small" for="tipo_veiculo">Tipo de veículo</label>
      <select class="form-select" id="tipo_veiculo" name="tipo_veiculo">
        <option value="">Todos</option>
        <% for (const t of tiposVeiculo) { %><option value="<%= t %>"<%= f.tipo_veiculo === t ? ' selected' : '' %>><%= rotulo(t) %></option><% } %>
      </select>
    </div>
    <div class="col-sm-6 col-lg-3">
      <label class="form-label small" for="cargo">Cargo</label>
      <select class="form-select" id="cargo" name="cargo">
        <option value="">Todos</option>
        <% for (const c of cargos) { %><option<%= f.cargo === c ? ' selected' : '' %>><%= c %></option><% } %>
      </select>
    </div>
    <div class="col-sm-6 col-lg-3">
      <label class="form-label small" for="setor">Setor</label>
      <select class="form-select" id="setor" name="setor">
        <option value="">Todos</option>
        <% for (const s of setores) { %><option<%= f.setor === s ? ' selected' : '' %>><%= s %></option><% } %>
      </select>
    </div>
    <div class="col-sm-6 col-lg-3">
      <label class="form-label small" for="empresa">Empresa</label>
      <input class="form-control" id="empresa" name="empresa" value="<%= f.empresa %>">
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="sem_saida" name="sem_saida" value="1"<%= f.sem_saida ? ' checked' : '' %>>
        <label class="form-check-label" for="sem_saida">Somente sem saída</label>
      </div>
    </div>
    <div class="col-12 d-flex gap-2">
      <button class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Gerar relatório</button>
      <a class="btn btn-outline-secondary" href="/relatorios">Limpar</a>
    </div>
  </div>
</form>

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3"><div class="card shadow-sm text-center"><div class="card-body">
    <div class="text-body-secondary small">Período</div>
    <div class="fw-semibold"><%= fmtData(r.de) %><%= r.de !== r.ate ? ' a ' + fmtData(r.ate) : '' %></div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm text-center"><div class="card-body">
    <div class="text-body-secondary small">Entradas</div><div class="fs-3 fw-bold"><%= r.totais.entradas %></div>
    <div class="small text-body-secondary"><i class="bi bi-car-front" aria-hidden="true"></i> <%= r.totais.entradas_veiculos || 0 %> de veículo ·
      <i class="bi bi-person-walking" aria-hidden="true"></i> <%= r.totais.entradas_pedestres || 0 %> a pé</div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm text-center"><div class="card-body">
    <div class="text-body-secondary small">Veículos distintos</div><div class="fs-3 fw-bold"><%= r.totais.veiculos %></div>
    <div class="small text-body-secondary"><%= r.totais.pedestres || 0 %> pedestre(s) distinto(s)</div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm text-center"><div class="card-body">
    <div class="text-body-secondary small">Permanência média</div>
    <div class="fs-3 fw-bold"><%= r.totais.media_minutos != null ? fmtDuracao(r.totais.media_minutos) : '—' %></div>
    <% if (r.totais.sem_saida) { %><div class="small text-warning-emphasis"><%= r.totais.sem_saida %> sem saída (fora da média)</div><% } %>
  </div></div></div>
</div>

<% if (r.totais.entradas > r.linhas.length) { %>
  <div class="alert alert-warning"><i class="bi bi-info-circle me-1"></i>Mostrando as primeiras <%= limiteTela %> linhas.
    O arquivo Excel contém todas as <%= r.totais.entradas %>.</div>
<% } %>

<div class="table-responsive card shadow-sm">
  <table class="table table-sm table-hover align-middle mb-0">
    <thead class="table-light">
      <tr><th>Data</th><th>Acesso</th><th>Entrada</th><th>Saída</th><th>Perm.</th><th>Pessoa</th><th>Tipo</th><th>Cargo</th><th>Setor</th>
        <th>Empresa</th><th>Placa</th><th>Veículo</th><th>Proprietário</th></tr>
    </thead>
    <tbody>
      <% if (!r.linhas.length) { %><tr><td colspan="13" class="text-center text-body-secondary py-4">Nenhuma movimentação no período/filtros escolhidos.</td></tr><% } %>
      <% for (const l of r.linhas) { %>
        <tr>
          <td><%= fmtData(l.entrada_em) %></td>
          <td class="text-nowrap"><% if (l.acesso === 'PEDESTRE') { %><span class="chip chip-neutro"><i class="bi bi-person-walking" aria-hidden="true"></i>A pé</span><% } else { %><span class="chip chip-neutro"><i class="bi bi-car-front" aria-hidden="true"></i>Veículo</span><% } %></td>
          <td><%= fmtHora(l.entrada_em) %></td>
          <td class="text-nowrap"><% if (l.saida_em) { %><%= l.saida_em.slice(0, 10) === l.entrada_em.slice(0, 10) ? fmtHora(l.saida_em) : fmtDataHora(l.saida_em) %><% } else { %><span class="chip chip-atencao"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>Sem saída</span><% } %></td>
          <td><%= fmtDuracao(l.minutos) %></td>
          <td><%= l.motorista_nome %></td>
          <td><%= rotulo(l.motorista_tipo) %></td>
          <td><%= l.cargo || '' %></td>
          <td><%= l.setor || '' %></td>
          <td><%= l.empresa || '' %></td>
          <td class="placa-cel"><%= l.placa ? placa(l.placa) : '' %></td>
          <td><%= l.acesso === 'PEDESTRE' ? '' : rotulo(l.veiculo_tipo) %><%= l.marca_modelo ? ' · ' + l.marca_modelo : '' %><%= l.cor ? ' · ' + l.cor : '' %></td>
          <td><%= l.proprietario_nome || '' %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer', { scripts: ['/js/relatorios.js'] }) %>
