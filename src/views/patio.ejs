<%- include('partials/header', { autoRefresh: 60 }) %>
<%
  const criticos = lista.filter((m) => m.alerta === 'vermelho').length;
  const atencao = lista.filter((m) => m.alerta === 'amarelo').length;
  const normais = lista.length - criticos - atencao;
  const STATUS = {
    vermelho: ['chip-solido-bloq', 'bi-slash-circle', 'Desde dia anterior'],
    amarelo: ['chip-solido-atencao', 'bi-exclamation-triangle-fill', 'Após ' + horaFimDia],
    normal: ['chip-info', 'bi-p-circle-fill', 'No estacionamento'],
  };
%>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h1 class="h2 mb-1"><i class="bi bi-p-square-fill text-primary me-2" aria-hidden="true"></i>Veículos no estacionamento agora</h1>
    <p class="text-body-secondary mb-0">Atualizado às <span class="font-monospace"><%= fmtHora(agora()) %></span> · a lista se atualiza sozinha a cada minuto.</p>
  </div>
  <a class="btn btn-outline-primary" href="/patio"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Atualizar</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card resumo-card h-100"><div class="card-body">
    <div class="titulo"><i class="bi bi-car-front me-1" aria-hidden="true"></i>Total no estacionamento</div>
    <div class="numero mt-2"><%= lista.length %></div><div class="text-body-secondary">veículos</div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card resumo-card h-100"><div class="card-body">
    <div class="titulo"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Normais</div>
    <div class="numero mt-2"><%= normais %></div><div class="text-body-secondary">permanência regular</div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card resumo-card atencao h-100"><div class="card-body">
    <div class="titulo"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Atenção</div>
    <div class="numero mt-2"><%= atencao %></div><div class="text-body-secondary">no estacionamento após <%= horaFimDia %></div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card resumo-card critico h-100"><div class="card-body">
    <div class="titulo"><i class="bi bi-slash-circle me-1" aria-hidden="true"></i>Crítico</div>
    <div class="numero mt-2"><%= criticos %></div><div class="text-body-secondary">sem saída desde dia anterior</div>
  </div></div></div>
</div>

<% if (!lista.length) { %>
  <div class="alert alert-info"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Nenhum veículo no estacionamento no momento.</div>
<% } else { %>
<div class="card mb-3">
  <div class="card-body d-flex flex-wrap gap-3 align-items-center">
    <div class="flex-grow-1 filtro-campo">
      <label class="visually-hidden" for="filtro-patio">Filtrar por placa, motorista ou modelo</label>
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input class="form-control" id="filtro-patio" type="search" placeholder="Filtrar por placa, motorista ou modelo…" autocomplete="off">
      </div>
    </div>
    <div class="btn-group filtro-patio" role="group" aria-label="Mostrar">
      <button type="button" class="btn btn-outline-primary" data-filtro="todos" aria-pressed="true">Todos (<%= lista.length %>)</button>
      <button type="button" class="btn btn-outline-primary" data-filtro="vermelho" aria-pressed="false">Críticos (<%= criticos %>)</button>
      <button type="button" class="btn btn-outline-primary" data-filtro="amarelo" aria-pressed="false">Atenção (<%= atencao %>)</button>
    </div>
  </div>
</div>

<div class="table-responsive card">
  <table class="table table-hover align-middle mb-0 tabela-grande">
    <thead class="table-light">
      <tr>
        <th>Situação</th><th>Placa</th><th>Veículo</th><th>Motorista</th><th>Entrada</th><th>Permanência</th><th class="text-end">Ação</th>
      </tr>
    </thead>
    <tbody>
      <% for (const m of lista) { const [cls, icone, texto] = STATUS[m.alerta || 'normal']; %>
        <tr class="<%= m.alerta === 'vermelho' ? 'table-danger' : (m.alerta === 'amarelo' ? 'table-warning' : '') %>"
            data-alerta="<%= m.alerta || 'normal' %>"
            data-busca="<%= [m.placa, placa(m.placa), m.motorista_nome, m.marca_modelo, m.cor].filter(Boolean).join(' ').toLowerCase() %>">
          <td><span class="chip <%= cls %>"><i class="bi <%= icone %>" aria-hidden="true"></i><%= texto %></span></td>
          <td><a class="placa <%= placaClasse(m.placa) %>" href="/veiculos/<%= m.veiculo_id %>"><%= placa(m.placa) %></a></td>
          <td><strong><%= [m.marca_modelo, m.cor].filter(Boolean).join(' · ') || rotulo(m.veiculo_tipo) %></strong>
            <div class="text-body-secondary"><%= rotulo(m.veiculo_tipo) %></div></td>
          <td><a href="/pessoas/<%= m.motorista_id %>" class="fw-bold text-decoration-none"><%= m.motorista_nome %></a>
            <div class="text-body-secondary"><%= rotulo(m.motorista_tipo) %><%= m.empresa ? ' · ' + m.empresa : (m.cargo ? ' · ' + m.cargo : '') %></div></td>
          <td class="text-nowrap font-monospace">
            <%= m.entrada_em.slice(0, 10) === hoje() ? 'Hoje' : fmtData(m.entrada_em).slice(0, 5) %>, <%= fmtHora(m.entrada_em) %>
          </td>
          <td class="text-nowrap"><span class="chip <%= m.alerta === 'vermelho' ? 'chip-bloq' : (m.alerta === 'amarelo' ? 'chip-atencao' : 'chip-neutro') %> font-monospace">
            <i class="bi bi-clock" aria-hidden="true"></i><%= fmtPermanencia(m.minutos) %></span></td>
          <td class="text-end">
            <form method="post" action="/patio/<%= m.id %>/saida" data-confirm="Registrar a saída de <%= placa(m.placa) %> agora?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-warning text-nowrap"><i class="bi bi-box-arrow-left" aria-hidden="true"></i>Registrar saída</button>
            </form>
          </td>
        </tr>
      <% } %>
      <tr class="d-none" id="patio-vazio"><td colspan="7" class="text-center text-body-secondary py-4">Nenhum veículo corresponde ao filtro.</td></tr>
    </tbody>
  </table>
</div>
<% } %>
<%- include('partials/footer', { scripts: ['/js/patio.js'] }) %>
