# Porta da aplicação (a 3000 já é usada por outro sistema na VM)
PORT=3001

# Fuso horário: todas as datas são gravadas e exibidas neste fuso
TZ=America/Manaus

# Segredo das sessões: gere um valor aleatório longo, por exemplo com
#   openssl rand -hex 32
SESSION_SECRET=

# Usuário administrador criado na primeira execução (se não houver usuários)
ADMIN_USER=Portaria2
# Senha usada SOMENTE na primeira execução. Depois, troque pela interface.
ADMIN_PASSWORD=

# Horário a partir do qual veículos ainda no pátio geram alerta
HORA_FIM_DIA=18:00

# Quantos dias de backups diários manter em data/backups
BACKUP_RETENCAO_DIAS=30
